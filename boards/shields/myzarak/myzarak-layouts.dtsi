// See https://zmk.dev/docs/development/hardware-integration/physical-layouts
// for how to configure this.

#include <physical_layouts.dtsi>

/ {
    default_layout: default_layout {
        compatible = "zmk,physical-layout";
        display-name = "Default Layout";
        transform = <&default_transform>;
        kscan = <&kscan>;

        // Edit this to define the positions and sizes of the keys, or remove it
        // if your keyboard will not support ZMK Studio.
        // https://zmk.dev/docs/development/hardware-integration/physical-layouts#optional-keys-property
        // Approximate layout for ZMK Studio's visual editor — cosmetic only,
        // does not affect key function. Order matches the transform's map
        // (54 keys: 4 rows x 12 cols, then the 6-key thumb row).
        // Refine visually in ZMK Studio, or replace with your Ergogen
        // point coordinates for exact placement.
        keys  //             w   h    x    y  rot   rx   ry
            = <&key_physical_attrs 100 100    0    0 0 0 0>
            , <&key_physical_attrs 100 100  100    0 0 0 0>
            , <&key_physical_attrs 100 100  200    0 0 0 0>
            , <&key_physical_attrs 100 100  300    0 0 0 0>
            , <&key_physical_attrs 100 100  400    0 0 0 0>
            , <&key_physical_attrs 100 100  500    0 0 0 0>
            , <&key_physical_attrs 100 100  630    0 0 0 0>
            , <&key_physical_attrs 100 100  730    0 0 0 0>
            , <&key_physical_attrs 100 100  830    0 0 0 0>
            , <&key_physical_attrs 100 100  930    0 0 0 0>
            , <&key_physical_attrs 100 100 1030    0 0 0 0>
            , <&key_physical_attrs 100 100 1130    0 0 0 0>
            , <&key_physical_attrs 100 100    0  100 0 0 0>
            , <&key_physical_attrs 100 100  100  100 0 0 0>
            , <&key_physical_attrs 100 100  200  100 0 0 0>
            , <&key_physical_attrs 100 100  300  100 0 0 0>
            , <&key_physical_attrs 100 100  400  100 0 0 0>
            , <&key_physical_attrs 100 100  500  100 0 0 0>
            , <&key_physical_attrs 100 100  630  100 0 0 0>
            , <&key_physical_attrs 100 100  730  100 0 0 0>
            , <&key_physical_attrs 100 100  830  100 0 0 0>
            , <&key_physical_attrs 100 100  930  100 0 0 0>
            , <&key_physical_attrs 100 100 1030  100 0 0 0>
            , <&key_physical_attrs 100 100 1130  100 0 0 0>
            , <&key_physical_attrs 100 100    0  200 0 0 0>
            , <&key_physical_attrs 100 100  100  200 0 0 0>
            , <&key_physical_attrs 100 100  200  200 0 0 0>
            , <&key_physical_attrs 100 100  300  200 0 0 0>
            , <&key_physical_attrs 100 100  400  200 0 0 0>
            , <&key_physical_attrs 100 100  500  200 0 0 0>
            , <&key_physical_attrs 100 100  630  200 0 0 0>
            , <&key_physical_attrs 100 100  730  200 0 0 0>
            , <&key_physical_attrs 100 100  830  200 0 0 0>
            , <&key_physical_attrs 100 100  930  200 0 0 0>
            , <&key_physical_attrs 100 100 1030  200 0 0 0>
            , <&key_physical_attrs 100 100 1130  200 0 0 0>
            , <&key_physical_attrs 100 100    0  300 0 0 0>
            , <&key_physical_attrs 100 100  100  300 0 0 0>
            , <&key_physical_attrs 100 100  200  300 0 0 0>
            , <&key_physical_attrs 100 100  300  300 0 0 0>
            , <&key_physical_attrs 100 100  400  300 0 0 0>
            , <&key_physical_attrs 100 100  500  300 0 0 0>
            , <&key_physical_attrs 100 100  630  300 0 0 0>
            , <&key_physical_attrs 100 100  730  300 0 0 0>
            , <&key_physical_attrs 100 100  830  300 0 0 0>
            , <&key_physical_attrs 100 100  930  300 0 0 0>
            , <&key_physical_attrs 100 100 1030  300 0 0 0>
            , <&key_physical_attrs 100 100 1130  300 0 0 0>
            , <&key_physical_attrs 100 100  200  400 0 0 0>
            , <&key_physical_attrs 100 100  300  400 0 0 0>
            , <&key_physical_attrs 100 100  400  400 0 0 0>
            , <&key_physical_attrs 100 100  530  400 0 0 0>
            , <&key_physical_attrs 100 100  630  400 0 0 0>
            , <&key_physical_attrs 100 100  730  400 0 0 0>
            ;
    };
};
